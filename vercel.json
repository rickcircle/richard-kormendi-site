{
  "functions": {
    "api/pagespeed.js": { "maxDuration": 60 }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/analytics-digest", "schedule": "0 11 * * *" },
    { "path": "/api/analytics-digest", "schedule": "0 17 * * *" }
  ]
}
